# Tezos Baker minimal configuration for npm scripts

# Network to join (ghostnet for testnet)
TEZOS_NETWORK=ghostnet

# Octez Docker image tag used by all npm scripts
OCTEZ_VERSION=octez-v23.1

# Protocol hash for the baker binary (PsQuebec for Ghostnet)
PROTOCOL=PsQuebec

# Prefix used for container names
CONTAINER_PREFIX=tezos

# Data directory mounted into octez-node
DATA_DIR=./data

# Snapshot download/storage directory
BACKUP_DIR=./backups

# RPC endpoint configuration (node listens on RPC_PORT; client connects via RPC_ADDR)
RPC_PORT=8732
RPC_ADDR=127.0.0.1

# P2P and metrics ports exposed by the node
P2P_PORT=9732
METRICS_PORT=9095

# Baker account alias managed by octez-client
BAKER_ALIAS=alice

# History mode for the node (rolling requires snapshot import)
HISTORY_MODE=rolling
