# Tezos Baker Configuration
# Copy this file to .env and customize as needed

# ============================================
# Basic Configuration
# ============================================
TEZOS_NETWORK=ghostnet
OCTEZ_VERSION=octez-v23.1
PROTOCOL=PsQuebec
CONTAINER_PREFIX=tezos

# ============================================
# Directory Configuration
# ============================================
DATA_DIR=./data
BACKUP_DIR=./backups

# ============================================
# Network Configuration
# ============================================
RPC_PORT=8732
RPC_ADDR=0.0.0.0
P2P_PORT=9732
METRICS_PORT=9095

# ============================================
# Node Configuration
# ============================================
HISTORY_MODE=rolling
# Options: rolling, full, archive
# rolling: Recommended for most use cases (saves disk space)
# full: Keeps all blocks (requires more disk space)
# archive: Full history + context (requires most disk space)

BAKER_ALIAS=alice

# ============================================
# Production Options
# ============================================

# Container Resource Limits
NODE_MEMORY_LIMIT=4g
# Memory limit for node container (e.g., 2g, 4g, 8g)
# Recommended: 4GB minimum for production

NODE_CPU_LIMIT=2.0
# CPU limit for node container (e.g., 1.0, 2.0, 4.0)
# Recommended: 2+ cores for production

# Restart Policy
RESTART_POLICY=unless-stopped
# Options: no, always, on-failure, unless-stopped
# Recommended: unless-stopped for production

# Logging
LOG_LEVEL=info
# Options: debug, info, notice, warning, error
# Recommended: info for production (debug for troubleshooting)

# ============================================
# Feature Flags
# ============================================
ENABLE_METRICS=true
# Enable Prometheus metrics endpoint
# Recommended: true for production monitoring

ENABLE_RPC_CORS=false
# Enable CORS for RPC endpoint
# Recommended: false for production (security)

# ============================================
# P2P Network Configuration
# ============================================
MAX_CONNECTIONS=100
# Maximum number of peer connections
# Recommended: 50-100 for production

MAX_INCOMING_CONNECTIONS=25
# Maximum incoming connections
# Recommended: 20-25 for production

PRIVATE_MODE=false
# Run node in private mode (no peer discovery)
# Recommended: false for production (unless you have specific requirements)

# ============================================
# Health Check Configuration
# ============================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ============================================
# Monitoring (Optional)
# ============================================
# Uncomment to enable monitoring stack
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN=admin
# GRAFANA_PASS=change_me_secure

# ============================================
# Timezone
# ============================================
TZ=UTC

# ============================================
# Production Readiness Checklist
# ============================================
# Before deploying to production, ensure:
# 1. ✅ All ports are available and not conflicting
# 2. ✅ Sufficient disk space (50GB+ recommended)
# 3. ✅ Snapshot imported (for rolling mode)
# 4. ✅ Node identity generated
# 5. ✅ Resource limits set appropriately
# 6. ✅ Restart policy configured
# 7. ✅ Logging configured
# 8. ✅ Monitoring enabled (if needed)
# 9. ✅ Security settings reviewed (CORS, ACL)
# 10. ✅ Backup strategy in place
#
# Run validation: npm run validate:production
