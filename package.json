    "node:logs": "./scripts/node-logs.sh",
    "node:logs:tail": "./scripts/node-logs-tail.sh",
    "node:health": "./scripts/node-health.sh",
    "node:sync-status": "./scripts/node-sync-status.sh",
    "snapshot:download": "./scripts/snapshot-download.sh",
